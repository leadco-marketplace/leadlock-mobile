# Dependencies — never commit; restored by `npm install` / EAS build
node_modules/

# Expo / build artifacts
.expo/
dist/
web-build/
*.tsbuildinfo

# Native build folders (generated by prebuild / EAS)
/ios
/android

# Logs & OS cruft
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store

# Local env (keep .npmrc, eas.json, app.json, app.config.js, google-services.json committed)
.env*.local
